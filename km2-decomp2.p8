function loadmus(m)
--sprite flags->sfx instrument
	memcpy(0x3200,m>6 and 0x3044 or 0x3000,68)
	local idx,addr=0,0x3244
	local function gseg()
		idx+=1
		ch=ord(mus[m][idx])
		return ch
	end
	
	--music table
	for i=0x3100,0x31ff,4 do
		pmb=gseg()
		poke(i,gseg(),pmb,gseg())
		if pmb>=128 then break end
	end
	
	--speed
	gseg()
	for i=0x3285,0x3b08,68 do
		poke(i,ch)
	end
	
	--base fx
	while gseg()<224 do
		pma=ch
		gseg()
		for i=0,pma%64 do
			for j=0,63,2 do
				poke(addr+j,pma&192,ch)
			end
			addr+=68
		end
	end
	
	--specific fx
	while ch<255 do
		if ch==253 then
			pma,addr=gseg(),0x3244+(ch&63)*68
			pmb=gseg()
		elseif ch==254 then
			addr+=68
		else
			for i=0,(ch&224)>>>4,2 do
				poke(addr+(ch&31)*2+i,pma&192,pmb)
			end
		end
		gseg()
	end
	
	--notes
	addr=0x3244
	while gseg()<255 do
		local npos=0
		while ch<254 do
			--print(((addr-0x3200)/68)..":"..(npos/2).."+"..(ch%4)+1)
			for i=0,ch%4 do
				poke(addr+npos,peek(addr+npos)+(ch>>>2))
				npos+=2
			end
			gseg()
		end
		poke(addr+0x42,npos/2,0)
		addr+=68
	end
	music"0"
end

--[[
~ rEPEAT UNTIL BYTE b IS >=128 ~
 define music pattern
  bbbbbbbb..aaaaaaaa..cccccccc

~ rEPEAT TIL 1ST BYTE IS >=224 ~
 fill n+1 sfx with vol+ins+fx
  ii0nnnnn.seeevvvi

~ rEPEAT UNTIL MODE SWITCH ~
 set new parameters,goto n+1 sfx
  11111101..ii0nnnnn..seeevvvi // 253..a..b

 run from note n
  rrrnnnnn (highest is 249 // 11111001)

 next sfx
  11111110 // 254

 to note mode
  11111111 // 255

~ rEPEAT UNTIL TERMINATED ~
 note+run
  nnnnnnrr
   prepend 235..nnnnrrrr to
   repeat upcoming n chars r
   times

 set length,end sfx
  11111110 // 254

 terminate
  11111111 // 255
]]
