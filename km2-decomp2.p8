pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	function usp(n)
		return unpack(split(n))
	end
	cls"0"
	spr(1,56,56,2,2)
	mux=4
	loadmus(mux)
	pal(13,140,1)
	sffx=0
	pl1={12,13,1,13}
	pl2={13,1,0,1}
	pln=0
	has={}
	for i=0,255 do
		add(has,i)
	end
	for m in all(mus) do
		for i=1,#m do
			del(has,ord(m[i]))
		end
	end
	hs=-122
end

function _update60()
	if btnp(5) then sffx+=1 music"-1" sfx(sffx,0) end
	if btnp(4) then music"-1" sfx(sffx,0) end
	
	if btnp(0) then
		mux=max(1,mux-1)
		loadmus(mux)
	end
	if btnp(1) then
		mux=min(#mus,mux+1)
		loadmus(mux)
	end
end

function _draw()
	pln+=0.125
	pln%=4
	pal(13,pl1[flr(pln)+1])
	pal(1,pl2[flr(pln)+1])
	cls"0"
	spr(1,56,56,2,2)
	pal(13,140,1)
	print(sffx,63-#tostr(sffx)*2,64,12)
	if btn(2) then hs+=1 end
	if btn(3) then hs-=1 end
	for i=1,#has do
		print(has[i],1,i*6-hs,5)
	end
end
