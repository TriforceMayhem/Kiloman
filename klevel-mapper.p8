function _update60()

end

function _draw()
	cls()
	print("\f7unused values:")
	for i=0,#unsd-1 do
		spr(unsd[i+1],(i%14)*9,flr(i/14)*9+6)
		if btn"4" or btn"5" then
			local tx=sub(tostr(unsd[i+1],true),5,6)
			if btn"5" then tx=chr(unsd[i+1]) end
			print("\#0\f7"..tx,(i%14)*9,flr(i/14)*9+9)
		end
	end
	print("total bytes: "..total,0,123,total>1792 and 8 or 7)
	if exp then
		print("\f7exported",96,123)
	end
end

