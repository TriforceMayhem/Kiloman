pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	crep={
		[0]="\\0",
		[10]="\\n",
		[13]="\\r",
		[34]="\\\"",
		[92]="\\\\"
	}
	
	for i=0,63 do
		if peek(0x3242+i*68)==0 then
			poke(0x3242+i*68,32)
		end
	end
	
	ndsp=split"c-,c#,d-,d#,e-,f-,f#,g-,g#,a-,a#,b-"
	sfxp=1
	notes,fx={},{}
	readin(sfxp)
end

function _update60()
	if btnp(0) and sfxp>1 then
		sfxp-=1
		readin(sfxp)
		sfx"62"
	end
	if btnp(1) and sfxp<33 then
		sfxp+=1
		readin(sfxp)
		sfx"62"
	end
	if btnp(0,1) then
		local fuck=""
		for i=0,67 do
			fuck..=peek(0x3200+i)..","
		end
		printh(fuck,'@clip')
	end
end

function ccr(n)
	return crep[n] or chr(n)
end

function _draw()
	cls()
	local oldval,cl,cnt,ccnt=-1,true,0,0
	
	for i=1,#notes do
		cnt-=1
		if cnt<0 then
			cl=not cl
			ccnt+=1
			if ccnt<=#chrs then
				cnt=chrs[ccnt]&3
			end
		end
		print(ndsp[notes[i]%12+1]..flr(notes[i]/12),flr((i-1)/8)*20,(i-1)%8*6,cl and 13 or 6)
	end
	
	local cpos=1
	for i=1,#chrs do
		local cmo=cpos-1
		print(ccr(chrs[i]),flr(cmo/8)*20+12,cmo%8*6,5)
		cpos+=(chrs[i]&3)+1
	end
	print(#chrs,96,120)
	print(peek(68*sfxp+0x3242),48,120)
	
	print(sfxp,128-#tostr(sfxp)*4,0,13)
	
	local nspl=8
	for i=1,#fx do
		print(fx[i],flr((i-1)/nspl)*(256/nspl),52+(i-1)%nspl*6,(i+flr((i-1)/nspl))%2>0 and 6 or 13)
	end
	
	if btnp(4) then
		sfx(sfxp)
	end
	
	if btnp(5) then
		local str=""
		for i=1,#chrs do
			str..=ccr(chrs[i])
		end
		
		printh(str..chr(254),"@clip")
		sfx"63"
	end
end
-->8
function readin(sidx)
	notes={}
	chrs={}
	fx={}
	addr=0x3200+sidx*68
	idx=1
	cnt=0
	for i=addr,addr+peek(addr+66)*2-1,2 do
		local nval=peek(i)&63
		add(notes,nval)
		add(fx,((peek(i)&192)<<8)+peek(i+1))
	end
	
	oldval=notes[#notes]
	for i=#notes,0,-1 do
		if oldval!=notes[i] or cnt>3 then
			if oldval>-1 then
				add(chrs,(oldval<<2)+cnt-1,1)
			end
			cnt=0
		end
		oldval=notes[i]
		cnt+=1
	end
end
